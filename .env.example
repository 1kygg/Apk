# Copie para .env na raiz. Nunca envie .env ao Git.
# Apenas desenvolvimento local; configure banco/HTTPS reais antes de distribuir.
DATABASE_URL=postgresql://consta:CHANGE_ME_LOCAL_ONLY@localhost:5432/consta
TEST_DATABASE_URL=postgresql://consta:CHANGE_ME_TEST_ONLY@localhost:5432/consta_test
# Gere um valor aleatório >=32 bytes. Vazio impede iniciar a API.
JWT_SECRET=
HOST=0.0.0.0
PORT=3000
# IDs públicos permitidos no backend, separados por vírgula; não são e-mails.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# URL pública HTTPS da API, sem /v1. Emulador local: http://10.0.2.2:3000.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
# Habilite somente em desenvolvimento local com HTTP. Não usar em distribuição.
CONSTA_ALLOW_CLEARTEXT=false
