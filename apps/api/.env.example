# Copy values to an untracked local environment; never use this file as production credentials.
DATABASE_URL=postgresql://consta:local_dev_only@localhost:5432/consta
PORT=3000
HOST=0.0.0.0
# Generate >=32 random bytes; required for login. Example: openssl rand -base64 48
JWT_SECRET=
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
PUBLIC_APP_URL=consta://
# No paid map/auth service is enabled by this API.
