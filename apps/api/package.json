{
  "name": "@consta/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "test:integration": "RUN_DB_TESTS=1 vitest run test/integration.test.ts test/training-plans.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate:prod": "node dist/migrate.js"
  },
  "dependencies": {
    "@consta/domain": "*",
    "@consta/training": "*",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "5.6.1",
    "google-auth-library": "10.4.0",
    "jose": "^6.1.0",
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vitest": "3.2.4",
    "esbuild": "^0.25.10"
  }
}
